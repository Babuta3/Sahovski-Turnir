@model PrezentacioniSloj.PrezentacionaLogika.ViewModels.PrijavaViewModel

@{
    ViewData["Title"] = "Prijava";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">♟ Prijava</h4>
            </div>
            <div class="card-body">
                <form asp-action="Prijava" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="KorisnickoIme" class="form-label"></label>
                        <input asp-for="KorisnickoIme" class="form-control" />
                        <span asp-validation-for="KorisnickoIme" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Lozinka" class="form-label"></label>
                        <input asp-for="Lozinka" class="form-control" />
                        <span asp-validation-for="Lozinka" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-dark w-100">Prijavi se</button>
                </form>
            </div>
        </div>
    </div>
</div>