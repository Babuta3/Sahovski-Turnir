<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Evidencija šahovskih turnira</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
        <div class="container">
            <a class="navbar-brand" href="#">♟ Šahovski turniri</a>
            <div class="navbar-nav ms-auto">
                @if (Context.Session.GetString("KorisnickoIme") != null)
                {
                    <a class="nav-link" asp-controller="Turnir" asp-action="Spisak">Turniri</a>
                    <a class="nav-link" asp-controller="Igrac" asp-action="Spisak">Igrači</a>
                    <span class="nav-link text-light">@Context.Session.GetString("KorisnickoIme")</span>
                    <a class="nav-link" asp-controller="Nalog" asp-action="Odjava">Odjava</a>
                }
            </div>
        </div>
    </nav>
    <div class="container">
        @RenderBody()
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>